# Copy to .env.local for development:  cp .env.example .env.local
# Every variable is validated at startup by src/config/env.ts.
# Never put secrets in NEXT_PUBLIC_* variables — they are sent to browsers.

# ─── Site identity ────────────────────────────────────────────
NEXT_PUBLIC_SITE_NAME="K360"
NEXT_PUBLIC_SITE_TAGLINE="Find anything, anywhere in your city."
NEXT_PUBLIC_SITE_DESCRIPTION="A free, open, community-built guide to every place, shop and service in your city."

# Domain that city subdomains hang off.
#   Development: localhost:3000   → open http://kochi.localhost:3000
#   Production:  nsbglobal.net    → https://kochi.nsbglobal.net
NEXT_PUBLIC_ROOT_DOMAIN="localhost:3000"

# ─── Credits ──────────────────────────────────────────────────
NEXT_PUBLIC_CREATOR_NAME="Naseeb Naushad"
NEXT_PUBLIC_CREATOR_URL=""
NEXT_PUBLIC_REPOSITORY_URL=""

# ─── Supabase (Project Settings → API Keys) ───────────────────
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# ─── Maps ─────────────────────────────────────────────────────
# Any MapLibre-compatible style. OpenFreeMap is free with no API key.
NEXT_PUBLIC_MAP_STYLE_URL="https://tiles.openfreemap.org/styles/liberty"

# ─── Server-only secrets (never prefix with NEXT_PUBLIC_) ─────
# Lets the importer refresh cached pages after it writes data.
# Generate with: openssl rand -hex 32   (leave empty to disable the endpoint)
# Production: npx wrangler secret put REVALIDATE_SECRET
REVALIDATE_SECRET=""
# Where the importer sends refresh requests (the root domain of the app).
REVALIDATE_URL="http://localhost:3000/api/revalidate"
